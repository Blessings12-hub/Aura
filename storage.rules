rules_version = '2';

// ============================================================================
// Aura — Firebase STORAGE Security Rules
// ============================================================================
// IMPORTANT: this is a separate rules system from firestore.rules. Firestore
// rules only govern documents in Firestore; they do NOT cover files uploaded
// to Firebase Storage (e.g. Mood Chat voice notes). Without this file
// deployed, new Firebase Storage buckets deny all reads/writes by default,
// which is almost certainly why voice notes were failing to upload.
//
// Deploy this via the Firebase Console (Storage → Rules → paste + Publish)
// or `firebase deploy --only storage` if you have the Storage product
// enabled and firebase.json configured with a "storage" section pointing
// at this file.
// ============================================================================

service firebase.storage {
  match /b/{bucket}/o {

    // Mood Chat voice notes: voice/{mood}/{uid}-{timestamp}.webm
    // Any signed-in (anonymous) user can upload/read a voice note. Writes
    // are capped at 10MB and must actually be audio, so someone can't use
    // this path to host arbitrary files. Only the uploader (uid prefix in
    // the filename must match their own auth uid) can overwrite/delete
    // their own note.
    match /voice/{mood}/{fileName} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && fileName.matches(request.auth.uid + '-.*')
                    && request.resource.size < 10 * 1024 * 1024
                    && request.resource.contentType.matches('audio/.*');
      allow update, delete: if request.auth != null && fileName.matches(request.auth.uid + '-.*');
    }

    // Default deny — anything not explicitly matched above is blocked.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
