# Appwrite Cloud Free
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=
VITE_APPWRITE_DATABASE_ID=
VITE_APPWRITE_USERS_COLLECTION_ID=users
VITE_APPWRITE_VERIFICATION_COLLECTION_ID=verificationRequests
VITE_APPWRITE_REPORTS_COLLECTION_ID=reports

# Cloud Messaging VAPID key (push notifications)
# Firebase Console -> Project settings -> Cloud Messaging -> Web configuration
VITE_FIREBASE_VAPID_KEY=

# App Check (optional, currently opt-in — see comment in src/firebase.js)
# Firebase Console -> App Check -> register this web app with reCAPTCHA v3
VITE_FIREBASE_RECAPTCHA_SITE_KEY=6Lc_OVMtAAAAAAnaKz_A_S3s6S0Yry478jdltAJ6

# TURN server for Skill Swap / Match video calls (see src/hooks/useVideoCall.js)
# Without these, calls fall back to a free public TURN service that isn't
# reliable at real scale. VITE_TURN_URLS can be a single URL or a
# comma-separated list (e.g. from a provider that gives you several).
# Get these from a TURN provider's dashboard (Twilio, Cloudflare Calls,
# Metered.ca, Xirsys, etc.) — no CLI needed, just their web signup.
VITE_TURN_URLS=https://global.xirsys.net
VITE_TURN_USERNAME=Blessings23
VITE_TURN_CREDENTIAL=06b72316-82ca-11f1-a968-0242ac150002
