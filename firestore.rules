rules_version = '2';

// ============================================================================
// Aura — Firestore Security Rules
// ============================================================================
// Design notes (read before editing):
//
// 1. Every real user is a Firebase Anonymous Auth user. `users/{uid}` is
//    keyed by that auth uid, so request.auth.uid is always trustworthy and
//    matches the app's `userId` everywhere.
//
// 2. TRUE anonymity for Skill Swap / Event Buddy: no identity fields at
//    all are stored on those publicly-queried card documents. Match
//    Finder is intentionally different — its card shows age/gender to
//    everyone, matched or not, and only NAME and PHOTO are gated behind a
//    real match. Whichever fields are meant to stay gated for a given
//    activity live in `userIdentities/{uid}`, which only the owner or
//    someone with a *matched* pairing can read. Hiding fields in the UI
//    is not security — anyone with devtools can read an open query. These
//    rules enforce it server-side.
//
// 3. Pair docs (matchPairs / swapPairs) are id'd as `${sortedUidA}_${sortedUidB}`.
//    Only the two participants may read or write their own pair.
//
// 4. Chat subcollections (matchChats/{pairId}/messages, swapChats/..., 
//    eventChats/...) are only readable/writable by participants of that
//    pair/event — never by the general public.
//
// 5. Video call signaling (skillSwapCalls) requires BOTH participants to
//    have explicitly consented (offer only created after both accept),
//    and only the two participants can read/write the signaling doc.
//
// 6. Mood Chat / Daily Question stay anonymous group spaces: any signed-in
//    (anonymous) user can post/read, but can only edit/delete their own
//    message, and cannot spoof another user's userId on a message.
// ============================================================================

function signedIn() {
  return request.auth != null;
}

function isOwner(uid) {
  return signedIn() && request.auth.uid == uid;
}

// Server-side backstop for the age gate on Login.jsx (MIN_AGE = 16 there).
// The client already blocks submitting an age below this, but that's only
// ever a UI check — anyone can call the SDK directly with any payload. This
// is what actually prevents an underage value (or a tampered/negative one)
// from ever being written, on both the initial write and any later update.
// If MIN_AGE changes in Login.jsx, update the literal below to match.
function validAge(data) {
  return !('age' in data) || (data.age is int && data.age >= 16);
}

// Caps how long a public text field is allowed to be. Uses .get(field, '')
// instead of a presence check so it's safe to call even on documents where
// the field is legitimately absent (e.g. Mood Chat voice notes have no
// `text` field at all) — a missing field just becomes '' and passes.
function validText(value, maxLen) {
  return value is string && value.size() <= maxLen;
}

// True if request.auth.uid is matched with `otherUid` in matchPairs.
function isMatchedWith(otherUid) {
  return signedIn() && (
    (exists(/databases/$(database)/documents/matchPairs/$(request.auth.uid + '_' + otherUid)) &&
      get(/databases/$(database)/documents/matchPairs/$(request.auth.uid + '_' + otherUid)).data.status == 'matched') ||
    (exists(/databases/$(database)/documents/matchPairs/$(otherUid + '_' + request.auth.uid)) &&
      get(/databases/$(database)/documents/matchPairs/$(otherUid + '_' + request.auth.uid)).data.status == 'matched')
  );
}

// True if request.auth.uid is one of the two participants encoded in a
// "<uidA>_<uidB>" style pair/composite id.
function isParticipantOfPairId(pairId) {
  return signedIn() && (
    pairId.split('_')[0] == request.auth.uid || pairId.split('_')[1] == request.auth.uid
  );
}

// True if the caller has an /admins/{uid} doc. There's no self-service way
// to become an admin — that doc has no client-writable path anywhere in
// these rules, so the only way to grant admin access is for the project
// owner to create it manually from the Firebase Console (Firestore ->
// admins -> add document with that id -> any field, e.g. {role: 'admin'}).
function isAdmin() {
  return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
}

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------
    // ADMINS — allowlist of uids that may review reports (see below).
    // Nobody can read, write, or even check for the existence of anyone
    // else's admin doc — you can only look up your OWN, which is exactly
    // what the client's "am I an admin" check needs and no more. There is
    // deliberately no create/update/delete rule at all: this can only be
    // populated by the project owner directly in the Firebase Console.
    // ------------------------------------------------------------------
    match /admins/{uid} {
      allow get: if isOwner(uid);
      allow list, write: if false;
    }

    // ------------------------------------------------------------------
    // USERS — public-safe profile (avatarColor only). Age/gender live in
    // userIdentities, NOT here, so they are never broadcast to a general
    // "list all users" style query. Only the owner can write their doc.
    // ------------------------------------------------------------------
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isOwner(uid) && validAge(request.resource.data);
      allow update: if isOwner(uid) && validAge(request.resource.data);
      allow delete: if false;
    }

    // ------------------------------------------------------------------
    // USER IDENTITIES — name and photo. Only the owner, or someone the
    // owner has been MATCHED with in Match Finder, may read this. Nobody
    // but the owner may write it. Split out of a single "write" rule so
    // the age check only ever applies to create/update, never to delete
    // (a delete has no request.resource.data to validate against).
    //
    // Age/gender are also mirrored here for the account-level
    // users/{uid} doc to stay in sync, but they are NOT what this
    // collection exists to protect — matchProfiles (see below) already
    // shows age/gender to everyone. The two fields that only ever unlock
    // via a real match are displayName and photoURL.
    //
    // photoURL is a client-resized base64 data URL (see
    // src/lib/photoUpload.js) rather than a Storage file — there's no
    // separate Storage bucket in play for it, so this field-length cap is
    // the only backstop keeping a doc from ballooning towards Firestore's
    // 1 MiB document limit. 220,000 chars is comfortably above what the
    // client ever produces (a 320px-max-dimension JPEG) with headroom to
    // spare.
    // ------------------------------------------------------------------
    match /userIdentities/{uid} {
      allow read: if isOwner(uid) || isMatchedWith(uid);
      allow create: if isOwner(uid) && validAge(request.resource.data)
                    && validText(request.resource.data.get('displayName', ''), 100)
                    && validText(request.resource.data.get('photoURL', ''), 220000);
      allow update: if isOwner(uid) && validAge(request.resource.data)
                    && validText(request.resource.data.get('displayName', ''), 100)
                    && validText(request.resource.data.get('photoURL', ''), 220000);
      allow delete: if isOwner(uid);
    }

    // ------------------------------------------------------------------
    // MOOD CHAT — anonymous group rooms, keyed by mood name.
    // Anyone signed in (anonymously) can read/post. You can only send a
    // message as yourself, and can only delete your own message.
    // ------------------------------------------------------------------
    match /chats/{mood}/messages/{messageId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid
                    && validText(request.resource.data.get('text', ''), 3000)
                    // Storage upload failures fall back to embedding the
                    // recording directly as a base64 data URL on the doc
                    // (see MoodChat.jsx) — cap it well under Firestore's
                    // 1 MiB document limit so that path can't blow up a doc.
                    && validText(request.resource.data.get('voiceUrl', ''), 900000);
      allow update: if false;
      allow delete: if isOwner(resource.data.userId);
    }

    // ------------------------------------------------------------------
    // MATCH FINDER — public card. Unlike Skill Swap/Event Buddy, Match
    // Finder's card is DELIBERATELY not fully anonymous: age and gender
    // are shown on the browsable card itself (validated the same way the
    // account-level users/{uid} doc validates age, via validAge()). What
    // stays gated behind a real match is identity that could make someone
    // individually recognisable — name and photo — which live only in
    // userIdentities (see above) and are never present here. This rule
    // rejects a create/update that tries to add either of those fields to
    // a matchProfiles doc, so that boundary is enforced server-side, not
    // just by what the UI happens to send.
    // ------------------------------------------------------------------
    match /matchProfiles/{cardId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid
                    && validAge(request.resource.data)
                    && !('displayName' in request.resource.data)
                    && !('photoURL' in request.resource.data)
                    && validText(request.resource.data.get('gender', ''), 40)
                    && validText(request.resource.data.get('bio', ''), 300)
                    && validText(request.resource.data.get('hobbies', ''), 300)
                    && validText(request.resource.data.get('lookingFor', ''), 300);
      allow update: if isOwner(resource.data.userId) && validAge(request.resource.data)
                    && !('displayName' in request.resource.data)
                    && !('photoURL' in request.resource.data)
                    && validText(request.resource.data.get('gender', ''), 40)
                    && validText(request.resource.data.get('bio', ''), 300)
                    && validText(request.resource.data.get('hobbies', ''), 300)
                    && validText(request.resource.data.get('lookingFor', ''), 300);
      allow delete: if isOwner(resource.data.userId);
    }

    // matchPairs/{uidA_uidB} — only the two participants may read/write.
    // NOTE: `read` intentionally checks resource.data.userA/userB, NOT the
    // pairId itself. The app queries this collection with
    // where('userA','==',uid) / where('userB','==',uid) — Firestore can
    // only allow a *list* query if the rule is checkable against the same
    // fields the query filters on. An ID-pattern check (isParticipantOfPairId)
    // works fine for a single get-by-id, but silently denies the entire
    // list query here, because Firestore can't statically prove every
    // possible matching document would also satisfy an ID-based rule.
    match /matchPairs/{pairId} {
      // `resource == null` first so a get() on a not-yet-created pair doc
      // (the "does this pair exist yet" check before setDoc) doesn't throw
      // trying to read resource.data off nothing — that used to deny with
      // permission-denied on every very first request between two people.
      allow read: if signedIn() && (resource == null || resource.data.userA == request.auth.uid || resource.data.userB == request.auth.uid);
      allow create: if isParticipantOfPairId(pairId)
                    && (request.resource.data.userA == request.auth.uid || request.resource.data.userB == request.auth.uid);
      allow update: if isParticipantOfPairId(pairId);
      // Reject (by the recipient) or cancel (by the requester) — either
      // participant can delete the pair, but only while it's still
      // pending. Once status is 'matched' this is deliberately blocked:
      // unmatching a live match isn't the same action and isn't part of
      // this flow, so a matched pair can't be unilaterally wiped out here.
      allow delete: if isParticipantOfPairId(pairId) && resource.data.status != 'matched';
    }

    // matchChats/{pairId}/messages/{id} — only the matched pair can chat.
    match /matchChats/{pairId}/messages/{messageId} {
      allow read: if isParticipantOfPairId(pairId);
      allow create: if isParticipantOfPairId(pairId) && request.resource.data.userId == request.auth.uid
                    && validText(request.resource.data.get('text', ''), 3000);
      allow update: if false;
      allow delete: if isOwner(resource.data.userId);
    }

    // ------------------------------------------------------------------
    // SKILL SWAP — same pattern: public card has no age/gender.
    // ------------------------------------------------------------------
    match /skillSwaps/{itemId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid
                    && !('userAge' in request.resource.data)
                    && !('userGender' in request.resource.data)
                    && validText(request.resource.data.get('skill', ''), 300)
                    && validText(request.resource.data.get('want', ''), 300);
      allow update, delete: if isOwner(resource.data.userId);
    }

    match /swapPairs/{pairId} {
      // Same fix as matchPairs above: allow the pre-create existence check.
      allow read: if signedIn() && (resource == null || resource.data.userA == request.auth.uid || resource.data.userB == request.auth.uid);
      allow create: if isParticipantOfPairId(pairId)
                    && (request.resource.data.userA == request.auth.uid || request.resource.data.userB == request.auth.uid);
      allow update: if isParticipantOfPairId(pairId);
      // Same reasoning as matchPairs: reject/cancel while pending, never a
      // live match.
      allow delete: if isParticipantOfPairId(pairId) && resource.data.status != 'matched';
    }

    match /swapChats/{pairId}/messages/{messageId} {
      allow read: if isParticipantOfPairId(pairId);
      allow create: if isParticipantOfPairId(pairId) && request.resource.data.userId == request.auth.uid
                    && validText(request.resource.data.get('text', ''), 3000);
      allow update: if false;
      allow delete: if isOwner(resource.data.userId);
    }

    // Skill Swap video call signaling (WebRTC offer/answer/ICE). Only the
    // two matched participants can read or write it, and BOTH must have
    // accepted (enforced in-app before an offer is written; rule limits
    // who can touch the doc at all).
    match /skillSwapCalls/{pairId} {
      allow read, write: if isParticipantOfPairId(pairId);
      match /candidates/{candidateId} {
        allow read, write: if isParticipantOfPairId(pairId);
      }
    }

    // ------------------------------------------------------------------
    // EVENT BUDDY — same pattern: public card has no age/gender.
    // ------------------------------------------------------------------
    match /eventBuddy/{eventId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid
                    && !('userAge' in request.resource.data)
                    && !('userGender' in request.resource.data)
                    && validText(request.resource.data.get('eventName', ''), 150)
                    && validText(request.resource.data.get('place', ''), 200);
      allow update, delete: if isOwner(resource.data.userId);
    }

    // eventJoins/{eventId_uid} — the joiner writes their own join; the
    // event owner may update it (e.g. to accept). Anyone in userIds may read.
    match /eventJoins/{joinId} {
      // Same fix: allow the pre-create existence check (joinEvent() does a
      // getDoc() before the first setDoc()) without denying on a doc that
      // doesn't exist yet.
      allow read: if signedIn() && (resource == null || request.auth.uid in resource.data.userIds);
      allow create: if signedIn() && request.auth.uid in request.resource.data.userIds;
      allow update: if signedIn() && request.auth.uid in resource.data.userIds;
      // The host can reject a pending join, or the guest can cancel their
      // own pending request — same reasoning as matchPairs/swapPairs.
      // 'accepted' joins aren't deletable here (that would be "kick this
      // person from the event", a different action, not in scope).
      allow delete: if signedIn() && request.auth.uid in resource.data.userIds && resource.data.status != 'accepted';
    }

    match /eventChats/{eventId}/messages/{messageId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid
                    && validText(request.resource.data.get('text', ''), 3000);
      allow update: if false;
      allow delete: if isOwner(resource.data.userId);
    }

    // ------------------------------------------------------------------
    // DAILY QUESTION — anonymous answers, one collection per day.
    // ------------------------------------------------------------------
    match /dailyQuestions/{day}/answers/{answerId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid
                    && validText(request.resource.data.get('text', ''), 3000);
      allow update: if false;
      allow delete: if isOwner(resource.data.userId);
    }

    // ------------------------------------------------------------------
    // COLLAB STUDIO — shared live canvas. Anyone signed in can draw and
    // see cursors; you can only write/delete your own stroke or cursor.
    // ------------------------------------------------------------------
    match /collabStudio/{strokeId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if isOwner(resource.data.userId);
    }

    match /collabCursors/{uid} {
      allow read: if signedIn();
      allow write: if isOwner(uid);
    }

    // Collab Studio live chat — same anonymous-group-room pattern as Mood
    // Chat: one shared room since there's one shared canvas. Anyone
    // signed in can read/post; you can only send as yourself and only
    // delete your own message.
    match /collabChatMessages/{messageId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid
                    && validText(request.resource.data.get('text', ''), 3000);
      allow update: if false;
      allow delete: if isOwner(resource.data.userId);
    }

    // ------------------------------------------------------------------
    // PUSH TOKENS — deliberately its own collection, not a field on
    // users/{uid} (that doc is readable by ANY signed-in user, which would
    // leak every device's raw FCM token to anyone). Only the owner can
    // read or write their own token; the Cloud Function that actually
    // sends notifications (functions/index.js) uses the Admin SDK, which
    // bypasses these rules entirely, so this being owner-only-read doesn't
    // block it.
    // ------------------------------------------------------------------
    match /pushTokens/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && validText(request.resource.data.get('token', ''), 4096);
      allow update: if isOwner(uid) && validText(request.resource.data.get('token', ''), 4096);
      allow delete: if isOwner(uid);
    }

    // ------------------------------------------------------------------
    // BLOCKS — a user's personal block list. Doc id is always
    // "<blockerUid>_<blockedUid>", never sorted, so it's asymmetric by
    // design: you can only read/create/delete the row where YOU are the
    // blocker. There's deliberately no way to query "who has blocked me" —
    // that would let someone retaliate against whoever blocked them.
    // ------------------------------------------------------------------
    match /blocks/{blockId} {
      allow read: if signedIn() && resource.data.blockerId == request.auth.uid;
      allow create: if signedIn()
                    && blockId == request.auth.uid + '_' + request.resource.data.blockedId
                    && request.resource.data.blockerId == request.auth.uid
                    && request.resource.data.blockedId is string
                    && request.resource.data.blockedId != request.auth.uid;
      allow update: if false;
      allow delete: if signedIn() && resource.data.blockerId == request.auth.uid;
    }

    // ------------------------------------------------------------------
    // REPORTS — write-only from an ordinary client, on purpose. The
    // reporter themselves cannot read their own report back. The ONLY
    // read/update/delete path is isAdmin() — see the admins collection
    // above — which is how the in-app admin review screen works. This
    // still means a reported person has no way to detect who reported
    // them: even an admin reading the doc doesn't expose that to them.
    // ------------------------------------------------------------------
    match /reports/{reportId} {
      allow create: if signedIn()
                    && request.resource.data.reporterId == request.auth.uid
                    && request.resource.data.reportedId is string
                    && request.resource.data.reportedId != request.auth.uid
                    && request.resource.data.reason is string
                    && request.resource.data.reason.size() > 0
                    && request.resource.data.reason.size() < 300;
      allow read, update, delete: if isAdmin();
    }

    // ------------------------------------------------------------------
    // MOOD ACTIVITY — a lightweight daily counter (moodActivity/{day},
    // one field per mood holding a message count), used only to show
    // "X messages today" on the mood PICKER before someone commits to a
    // room, so an empty room doesn't look completely dead. Not user data,
    // not sensitive — anyone signed in can read/increment it. Field-level
    // validation isn't practical for arbitrary increment() calls, so this
    // is intentionally permissive; worst case someone inflates a vanity
    // counter, which isn't a security concern.
    // ------------------------------------------------------------------
    match /moodActivity/{day} {
      allow read: if signedIn();
      allow write: if signedIn();
    }

    // ------------------------------------------------------------------
    // Default deny — anything not explicitly matched above is blocked.
    // ------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
